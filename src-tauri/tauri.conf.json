{
  "productName": "Sunder",
  "version": "1.4.15",
  "identifier": "com.sunder.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sunder",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src * data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://lrclib.net https://api.lyrics.ovh https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgdk-pixbuf-2.0-0",
          "libglib2.0-0",
          "libcairo2",
          "libdbus-1-3",
          "libsoup-3.0-0",
          "libjavascriptcoregtk-4.1-0",
          "libasound2",
          "libpipewire-0.3-0"
        ],
        "recommends": [
          "libasound2-plugins"
        ]
      },
      "rpm": {
        "depends": [
          "libgdk-3.so.0()(64bit)",
          "libgdk_pixbuf-2.0.so.0()(64bit)",
          "libgio-2.0.so.0()(64bit)",
          "libglib-2.0.so.0()(64bit)",
          "libgobject-2.0.so.0()(64bit)",
          "libjavascriptcoregtk-4.1.so.0()(64bit)",
          "libsoup-3.0.so.0()(64bit)",
          "libcairo.so.2()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libasound.so.2()(64bit)",
          "libpipewire-0.3.so.0()(64bit)"
        ],
        "recommends": [
          "alsa-plugins-pulseaudio"
        ]
      }
    }
  }
}
